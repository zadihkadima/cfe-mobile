# ---------------------------------------------------------------------------
# CFE mobile/web client configuration.
#
# Copy to .env.local for development. Only EXPO_PUBLIC_* variables are inlined
# into the JavaScript bundle, so NEVER put a secret here: anything in this file
# is readable by anyone who installs the app.
# ---------------------------------------------------------------------------

# Base URL of the API, including the /api/v1 prefix.
# Leave unset in development to auto-detect the Metro host, which lets a
# physical device reach the developer machine without editing any file.
# Required for release builds; plaintext http:// is rejected outside dev.
EXPO_PUBLIC_API_URL=https://api.example.com/api/v1

# WebSocket endpoint. Optional: derived from EXPO_PUBLIC_API_URL when unset.
EXPO_PUBLIC_WS_URL=wss://api.example.com/api/v1/ws

